{
  "name": "app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "./scripts/prebuild.sh && expo run:ios -d",
    "web": "expo start --web",
    "ts:check": "tsc",
    "build:ios": "react-native bundle --entry-file='index.js' --bundle-output='./ios/main.jsbundle' --dev=false --platform='ios'",
    "android:bundle": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@aws-amplify/api-rest": "^4.0.6",
    "@aws-amplify/auth": "^6.0.6",
    "@aws-amplify/core": "^6.0.6",
    "@aws-amplify/react-native": "^1.0.5",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@rneui/base": "^4.0.0-rc.7",
    "@rneui/themed": "^4.0.0-rc.8",
    "aws-amplify": "^6.0.5",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.4",
    "expo-screen-orientation": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-element-dropdown": "^2.10.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal": "^13.0.1",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-vector-icons": "^10.0.3",
    "react-native-worklets": "0.13.0",
    "zen-observable-ts": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
