# Copy this file to android/keystore.properties (that copy is gitignored).
# storeFile is resolved from the android/ directory. Use an absolute path,
# or a path such as /secure/oslyn-upload.keystore that lives outside the repo.
#
# This is the Play upload key. It is not the app signing key: enroll the app
# in Play App Signing and let Google hold the app signing key.
storeFile=
storePassword=
keyAlias=upload
keyPassword=
